{
  "id": "11404",
  "title": "Italic text",
  "issue": 11404,
  "kind": "feature",
  "prompt": "Write test cases for Excalidraw issue #11404.",
  "decisions": [
    "A panel toggle and Ctrl/Cmd+I; one italic property per text element, no separate font.",
    "Whole element only. Bold is out of scope.",
    "Synthetic oblique is allowed; text stays readable and unclipped in Latin, Cyrillic, Chinese, Japanese, Arabic, Hebrew (right to left), emoji and mixed scripts; direction and alignment unchanged.",
    "The last italic value becomes the default for new text.",
    "Color and opacity changes keep italic."
  ],
  "bounds": {
    "cases_min": 15,
    "cases_max": 30,
    "high_max_share": 0.3
  },
  "must_update": [
    "C-011"
  ],
  "must_cover": [
    {
      "name": "italic toggle",
      "source": "issue",
      "any": [
        "\"Italic\"",
        "Italic toggle",
        "italic toggle"
      ]
    },
    {
      "name": "shortcut",
      "source": "issue",
      "any": [
        "Ctrl\\+I\\b",
        "Cmd\\+I\\b"
      ]
    },
    {
      "name": "right-to-left text",
      "source": "decision",
      "any": [
        "Arabic",
        "Hebrew",
        "right-to-left",
        "right to left"
      ]
    },
    {
      "name": "CJK text",
      "source": "decision",
      "any": [
        "Chinese",
        "Japanese",
        "CJK"
      ]
    },
    {
      "name": "default for new text",
      "source": "decision",
      "any": [
        "new text"
      ]
    },
    {
      "name": "text inside a shape",
      "source": "discovery",
      "any": [
        "inside (a|the) (rectangle|shape|ellipse|diamond)",
        "in a shape",
        "(rectangle|ellipse|diamond|shape)[^\\n]{0,80}\\binside it\\b",
        "text in(side)? (a|the) (rectangle|shape)"
      ]
    },
    {
      "name": "arrow label",
      "source": "discovery",
      "any": [
        "arrow label",
        "label[^\\n]{0,40}arrow"
      ]
    },
    {
      "name": "paste styles",
      "source": "discovery",
      "any": [
        "paste styles",
        "Ctrl\\+Alt\\+V"
      ]
    },
    {
      "name": "undo and redo",
      "source": "discovery",
      "any": [
        "Ctrl\\+Z"
      ]
    },
    {
      "name": "color change keeps italic",
      "source": "decision",
      "any": [
        "color"
      ]
    },
    {
      "name": "reload",
      "source": "discovery",
      "any": [
        "reload"
      ]
    },
    {
      "name": "saved file",
      "source": "discovery",
      "any": [
        "\\.excalidraw\\b"
      ]
    },
    {
      "name": "image export",
      "source": "discovery",
      "any": [
        "\\bPNG\\b"
      ]
    },
    {
      "name": "control label in another language",
      "source": "discovery",
      "any": [
        "locale",
        "translat",
        "language (other than|setting|selector|menu)",
        "(another|a different|other) (UI )?language"
      ]
    },
    {
      "name": "where the control is shown",
      "source": "discovery",
      "any": [
        "(where|when) (it|the control|the toggle|the \"[^\"]+\" (toggle|control)) is shown",
        "is (not )?shown (only )?(when|for|in the)",
        "not shown",
        "is hidden",
        "does not appear",
        "(toggle|control) is (not )?visible",
        "visibility"
      ]
    }
  ],
  "must_not": [
    {
      "name": "no link outside the product",
      "pattern": "https?://(?!([\\w-]+\\.)*(excalidraw\\.com|github\\.com)\\b)"
    },
    {
      "name": "invented preset name",
      "pattern": "Extra large"
    },
    {
      "name": "bold treated as in scope",
      "pattern": "Action: create[^#]{0,200}\\bBold\\b"
    }
  ]
}
