{
  "name": "qa-agent",
  "private": true,
  "description": "Run the mcp-server commands from the repository root, the same folder git uses.",
  "scripts": {
    "approve": "npm --prefix mcp-server run approve --",
    "review-knowledge": "npm --prefix mcp-server run review-knowledge",
    "build": "npm --prefix mcp-server run build",
    "test": "npm --prefix mcp-server test",
    "grade": "npm --prefix mcp-server run grade --",
    "freeze": "npm --prefix mcp-server run freeze --",
    "eval": "npm --prefix mcp-server run eval --",
    "eval-report": "npm --prefix mcp-server run eval-report",
    "regrade": "npm --prefix mcp-server run regrade --",
    "auto": "npm --prefix mcp-server run auto --"
  }
}
